# ============================================================
#  E-Commerce Aggregator — Environment Variables
#  Salin file ini ke .env dan isi nilainya
# ============================================================

# -- App --
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
LOG_LEVEL=debug
CORS_ORIGIN=*

# -- Database (wajib) --
# Di production, nilai ini di-inject otomatis via Google Secret Manager
MYSQL_URL=mysql://user:password@host:3306/dbname
MONGO_URL=mongodb://localhost:27017/ecommerce_aggregator

# -- Redis --
REDIS_HOST=localhost
REDIS_PORT=6379

# -- Auth (wajib, gunakan nilai yang kuat & random di production) --
# Di production, nilai ini di-inject otomatis via Google Secret Manager
JWT_SECRET=
JWT_EXPIRES_IN=1d

# -- Internal API Key (wajib) --
# Di production, nilai ini di-inject otomatis via Google Secret Manager
INTERNAL_API_KEY=

# -- GCP Storage --
GCP_BUCKET_NAME=

# -- Marketplace Mock API URLs --
SHOPEE_MARKETPLACE_BASE_URL=http://localhost:4000/api/shopee
TOKOPEDIA_MARKETPLACE_BASE_URL=http://localhost:4000/api/tokopedia
LAZADA_MARKETPLACE_BASE_URL=http://localhost:4000/api/lazada

# -- Sync --
MARKETPLACE_SYNC_TIMEOUT_MS=5000
